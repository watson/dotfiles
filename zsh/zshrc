[[ -r "$HOME/.zshrc.local.pre" ]] && source "$HOME/.zshrc.local.pre"

if [ -f "$HOME/.oh-my-zsh/oh-my-zsh.sh" ]; then
  source ~/dotfiles/zsh/zshrc.oh-my-zsh
fi

# Use fzf for fuzzy searching (installed via Homebrew)
if command -v fzf >/dev/null 2>&1; then
  source <(fzf --zsh)
fi

# Load Homebrew shell variables when Homebrew is installed.
if [ -x /opt/homebrew/bin/brew ]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [ -x /usr/local/bin/brew ]; then
  eval "$(/usr/local/bin/brew shellenv)"
elif command -v brew >/dev/null 2>&1; then
  eval "$(brew shellenv)"
fi

# Force certain more-secure behaviours from homebrew
export HOMEBREW_NO_INSECURE_REDIRECT=1
export HOMEBREW_CASK_OPTS=--require-sha
if command -v brew >/dev/null 2>&1; then
  export HOMEBREW_DIR="$(brew --prefix)"
  export HOMEBREW_BIN="$HOMEBREW_DIR/bin"
fi

# Prefer user-local binaries to general Homebrew and macOS binaries.
typeset -U path PATH
path=("$HOME/.local/bin" $path)

# Load Python shims when pyenv is installed.
if command -v pyenv >/dev/null 2>&1; then
  eval "$(pyenv init - --no-rehash)"
fi

# Load Ruby shims when rbenv is installed.
if command -v rbenv >/dev/null 2>&1; then
  eval "$(rbenv init -)"
fi

# Prefer GNU binaries to Macintosh binaries.
if [ -n "$HOMEBREW_DIR" ] && [ -d "$HOMEBREW_DIR/opt/coreutils/libexec/gnubin" ]; then
  export PATH="$HOMEBREW_DIR/opt/coreutils/libexec/gnubin:$PATH"
fi
if [ -n "$HOMEBREW_DIR" ] && [ -d "$HOMEBREW_DIR/opt/gnu-tar/libexec/gnubin" ]; then
  export PATH="$HOMEBREW_DIR/opt/gnu-tar/libexec/gnubin:$PATH"
fi

# Default editor for gh, git commit, etc.
if command -v cursor >/dev/null 2>&1; then
  export EDITOR="cursor --wait"
elif command -v code >/dev/null 2>&1; then
  export EDITOR="code --wait"
fi

# command history
export HISTSIZE=10000
export HISTFILE="$HOME/.history"
export SAVEHIST=$HISTSIZE
setopt hist_ignore_all_dups

# Node Version Manager
export NVM_DIR="$HOME/.nvm"
export NVM_AUTOLOAD=1
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"  # This loads nvm

# Node.js build tooling
export CC="ccache cc"
export CXX="ccache c++"

# Make Python 3.12 the default
export PATH="/opt/homebrew/opt/python@3.12/libexec/bin:$PATH"

# Fix and rebuild the Open With database
alias fixow='/System/Library/Frameworks/CoreServices.framework/Versions/A/Frameworks/LaunchServices.framework/Versions/A/Support/lsregister -kill -r -domain local -domain user;killall Finder;echo "Open With has been rebuilt, Finder will relaunch"'

alias nack='ack --ignore-dir=node_modules'
alias npm-offline='npm install --cache-min 999999'
alias unfuck='tput rmacs'
alias chrome='open -a /Applications/Google\ Chrome.app'

[[ -r "$HOME/.zshrc.local" ]] && source "$HOME/.zshrc.local"
